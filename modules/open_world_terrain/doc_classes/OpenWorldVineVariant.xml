<?xml version="1.0" encoding="UTF-8" ?>
<class name="OpenWorldVineVariant" inherits="Resource" api_type="core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../doc/class.xsd">
	<brief_description>Stores a baked static vine and its runtime metadata.</brief_description>
	<description>Contains three LOD meshes generated from one request and a support-loss policy for gameplay integration.</description>
	<tutorials></tutorials>
	<methods><method name="get_lod_index_for_distance" qualifiers="const"><return type="int" /><param index="0" name="distance" type="float" /><description>Returns a visible LOD or -1 beyond max distance.</description></method><method name="get_lod_mesh" qualifiers="const"><return type="Mesh" /><param index="0" name="lod" type="int" /><description>Returns the requested mesh with fallback toward LOD0.</description></method></methods>
	<members>
		<member name="lod0_mesh" type="Mesh" setter="set_lod0_mesh" getter="get_lod0_mesh">Full detail mesh.</member><member name="lod1_distance" type="float" setter="set_lod1_distance" getter="get_lod1_distance" default="18.0">LOD1 distance.</member><member name="lod1_mesh" type="Mesh" setter="set_lod1_mesh" getter="get_lod1_mesh">Reduced mesh.</member><member name="lod2_distance" type="float" setter="set_lod2_distance" getter="get_lod2_distance" default="42.0">LOD2 distance.</member><member name="lod2_mesh" type="Mesh" setter="set_lod2_mesh" getter="get_lod2_mesh">Ribbon/cluster mesh.</member><member name="max_distance" type="float" setter="set_max_distance" getter="get_max_distance" default="90.0">Maximum visibility distance.</member>
		<member name="source_mode" type="int" setter="set_source_mode" getter="get_source_mode" enum="OpenWorldVineGenerationRequest.VineMode" default="0">Source solver mode, including self-supporting Bramble.</member><member name="source_seed" type="int" setter="set_source_seed" getter="get_source_seed" default="0">Source seed.</member><member name="support_lost_policy" type="int" setter="set_support_lost_policy" getter="get_support_lost_policy" enum="OpenWorldVineVariant.SupportLostPolicy" default="1">Behavior requested when support disappears.</member><member name="support_stable_id" type="int" setter="set_support_stable_id" getter="get_support_stable_id" default="0">Persistence key.</member><member name="variant_name" type="String" setter="set_variant_name" getter="get_variant_name" default="&quot;Vine Variant&quot;">Display name.</member>
	</members>
	<constants><constant name="SUPPORT_KEEP" value="0" enum="SupportLostPolicy">Keep current static representation.</constant><constant name="SUPPORT_HIDE" value="1" enum="SupportLostPolicy">Hide the vine.</constant><constant name="SUPPORT_DETACH" value="2" enum="SupportLostPolicy">Request an external detach handler.</constant></constants>
</class>
